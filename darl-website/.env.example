# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# SMTP account used to deliver "Request a Test" enquiries.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries are delivered, and the From address used to send them.
QUOTE_TO_EMAIL=darltesting@gmail.com
QUOTE_FROM_EMAIL=
